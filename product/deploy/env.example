# /etc/modelsunset.env — real values live only on the server, never in the repo.
SITE_URL=https://modelsunset.dev
CONTACT_EMAIL=
X_HANDLE=
SUNSET_DB=/var/lib/modelsunset/alerts.db
# Outgoing mail (any SMTP provider). Without SMTP_HOST, mail is written to SUNSET_OUTBOX.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Model Sunset <alerts@modelsunset.dev>
SUNSET_OUTBOX=/var/lib/modelsunset/outbox
# Payments: leave empty until Stripe exists. The Pro button and webhook stay off without them.
STRIPE_PAYMENT_LINK=
STRIPE_WEBHOOK_SECRET=
# Long random string; lets the operator read subscriber counts at /api/stats?key=...
SUNSET_ADMIN_KEY=
